# Secrets and local env (never commit tokens)
.env
.env.*
!.env.example

# Python environments and bytecode
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS noise
.DS_Store

# Large ML blobs — full Trainer checkpoints / caches stay off GitHub
wandb/
checkpoints/

# Trainer checkpoints inside outputs/ (if present)
outputs/**/checkpoint-*/

# Ignore arbitrary weight dumps, but track MindForge LoRA adapters + trainer metadata (each file <100MB)
*.safetensors
!outputs/mindforge-qwen-lora/adapter_model.safetensors
!outputs/mindforge-qwen-lora-scale/adapter_model.safetensors
*.bin
!outputs/mindforge-qwen-lora/training_args.bin
!outputs/mindforge-qwen-lora-scale/training_args.bin

# Optional local bundle (same adapters as outputs/*/adapter_model.safetensors); too large for GitHub as a single blob
mindforge-qwen-lora-adapter.zip
