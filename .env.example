# MindForge AI — copy to `.env` for local runs / HF secrets (do not commit `.env`).
#
# --- Demo (stable hackathon UI / judges) ---
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
ADAPTER_DIR=outputs/mindforge-qwen-lora
DEMO_CASES_PATH=data/synthetic/mindforge_demo_cases.json

# --- Scale experiment (after overnight 100× train; BASE_MODEL must match training base) ---
# BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# ADAPTER_DIR=outputs/mindforge-qwen-lora-scale

# Hugging Face
HF_TOKEN=

# Gradio
PORT=7860
# Enough new tokens to emit full assistant JSON in one shot (no retrain needed).
MAX_NEW_TOKENS=3072
# Optional: pin Training results "compute snapshot" to a specific checkpoint
# TRAINER_STATE_JSON=outputs/mindforge-qwen-lora-scale/checkpoint-2700/trainer_state.json
# GRADIO_SHARE=1

# Optional hub model card default
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
